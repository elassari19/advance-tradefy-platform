{
  "name": "tradefy-electron",
  "productName": "Tradefy",
  "version": "1.0.0",
  "description": "Tradefy Desktop App",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "npm_config_user_agent=npm/10.8.2 electron-forge start",
    "build:renderer": "cd ../frontend && npx vite build",
    "build:electron": "tsc -p tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "package": "npm run build:renderer && npm_config_user_agent=npm/10.8.2 electron-forge package",
    "make": "npm run build:renderer && npm_config_user_agent=npm/10.8.2 electron-forge make",
    "publish": "npm_config_user_agent=npm/10.8.2 electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "hicham el assari",
    "email": "elassari19@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "electron": "^35.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~5.7.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
